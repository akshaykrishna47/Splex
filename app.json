{
  "expo": {
    "name": "Splex",
    "slug": "splex",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "splex",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0B0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.splex.client"
    },
    "android": {
      "package": "app.splex.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0B0F"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Splex",
      "shortName": "Splex",
      "description": "Split trip expenses across currencies without the arithmetic.",
      "themeColor": "#0A0B0F",
      "backgroundColor": "#0A0B0F",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "lang": "en",
      "orientation": "portrait"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
