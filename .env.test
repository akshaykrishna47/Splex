# Test environment. Committed on purpose — there is nothing secret here.
#
# `lib/supabase.ts` throws at import time when these are missing, and
# `tests/balances.test.ts` reaches it through `lib/repo/balances`. Locally
# `.env.local` happens to supply them, so the suite appears self-sufficient
# when it is not: on a fresh clone, or in CI, it fails on an import error that
# looks nothing like a missing environment variable.
#
# Vite's precedence is .env < .env.local < .env.[mode], and Vitest runs in test
# mode, so this file wins everywhere and CI needs no environment block.
#
# The values are deliberately fake. No test makes a network call, and pointing
# the suite at a real project would only invite one to start.

EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=test-anon-key-not-a-real-credential
