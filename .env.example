# Copy to .env.local and fill in. Never commit .env.local.
#
# Both values are safe to ship in the client bundle: the anon/publishable key
# only grants what Row Level Security allows. The service role key must NEVER
# appear here or anywhere in the app/ directory.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Server-side only. Used by supabase/seeds/ and never bundled into the client.
SUPABASE_SERVICE_ROLE_KEY=
SEED_ENABLED=false
